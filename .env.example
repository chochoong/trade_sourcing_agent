# .env.example 을 복사해서 .env 로 만든 뒤 값을 채우세요.
# ⚠️ 이 파일은 git 에 올라가는 견본입니다. 실제 키는 .env 에만 넣으세요.
ANTHROPIC_API_KEY=sk-ant-여기에_키_입력

# 사용할 모델 (비용 아끼려면 sonnet, 품질 우선이면 opus)
MODEL=claude-sonnet-5-5

# Claude API 웹 검색 툴 버전
WEB_SEARCH_TOOL=web_search_20260209

# 단계별 최대 검색 횟수 (많을수록 정확하지만 비용 증가)
MAX_SEARCHES_DISCOVER=15   # 후보 검색 (실행 1회에 1번)
MAX_SEARCHES_VERIFY=12     # 검증 (후보 1곳마다 1번)
MAX_SEARCHES_CHANNELS=8    # 구매 사이트 비교 (실행 1회에 1번)
MAX_SEARCHES_QUALITY=10    # 제품 품질·리뷰 (모델 1개마다 1번, 최대 QUALITY_MAX_MODELS 개)
QUALITY_MAX_MODELS=5

# (선택) 공식 마켓 API — 실제 판매가·판매 수·판매자·포장 무게 확인 (무료, 읽기 전용). 없으면 이 단계만 건너뜀
# AliExpress Open Platform 드롭쉬핑 앱 (중국). 로그인 토큰은 buyagent 가 발급·갱신하는 파일을 읽기만 함
ALIEXPRESS_APP_KEY=여기에_App_Key
ALIEXPRESS_APP_SECRET=여기에_App_Secret
# ALIEXPRESS_TOKEN_FILE=C:/workspace/buyagent/buyagent/data/aliexpress_token.json   # 기본값: BUYAGENT_DIR/data/
# eBay Developers Program Production 키셋 (미국): App ID → CLIENT_ID, Cert ID → CLIENT_SECRET
EBAY_CLIENT_ID=여기에_App_ID
EBAY_CLIENT_SECRET=여기에_Cert_ID
